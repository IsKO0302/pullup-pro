{
  "name": "@pullup/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PULLUP PRO sync API (Fastify + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "node ../../scripts/bundle.mjs apps/api/src/server.ts apps/api/dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@pullup/db": "2.0.0",
    "@pullup/shared": "2.0.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
