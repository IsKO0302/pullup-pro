# PULLUP PRO 2.0 — environment variables. Copy to .env and fill in. Never commit .env.
# All values here are placeholders, not real secrets. Empty = feature off / default.
# Read by: docker compose (env_file), npm run dev:api / dev:bot / start:api / start:bot / db:migrate.

# ===== PostgreSQL =====
# docker compose: builds DATABASE_URL for the containers from this password (required)
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# local run without Docker: connection string of your PostgreSQL 14+ database
DATABASE_URL=postgres://pullup:change-me-to-a-long-random-password@localhost:5432/pullup
# DB_POOL_MAX=10
# MIGRATIONS_DIR=
# MIGRATE_ON_START=true

# ===== API + web app (apps/api) =====
PORT=8080
HOST=0.0.0.0
# Public HTTPS address of the web app: Mini App URL in BotFather and links in bot messages
# example: WEBAPP_URL=https://fit.example.com/
WEBAPP_URL=
# Username of the bot (without @): enables "Sign in via Telegram bot" in the browser / PWA
# example: BOT_USERNAME=isa_pullup_bot
BOT_USERNAME=
# Behind Caddy / nginx / a load balancer: real client IPs for rate limiting
# TRUST_PROXY=true
# Comma-separated origins, only if the web app is served from another domain than the API
# CORS_ORIGINS=
# Path to apps/web/dist (default: found automatically; "off" = API only)
# WEB_DIST=
# Progress photos in the cloud (each user must also give explicit consent in the app)
# ALLOW_PHOTOS=true
# MAX_PHOTO_MB=15
# SESSION_TTL_DAYS=90
# Telegram initData older than this (seconds) is rejected
# INITDATA_MAX_AGE=86400
# Requests per minute per IP (all / sign-in)
# RATE_LIMIT=300
# AUTH_RATE_LIMIT=30
# LOG_LEVEL=info
# APP_VERSION=2.0.0

# ===== Telegram bot (apps/telegram-bot) =====
# Token from @BotFather — used by the API (validates Mini App initData) and by the bot. Keep it secret.
# Empty: the web app and PWA work, Telegram sign-in is disabled, the bot does not start.
BOT_TOKEN=
# polling (simplest, no public URL needed) or webhook
BOT_MODE=polling
# webhook mode only: public HTTPS URL that reaches the bot (see deploy/Caddyfile) and a random secret (16-256 chars)
# WEBHOOK_URL=https://fit.example.com/tg-webhook
# WEBHOOK_SECRET=
# BOT_PORT=8081
# BOT_HOST=0.0.0.0
# Reminders configured in the app (Settings -> Reminders)
# REMINDERS=true
# REMINDER_WINDOW_MIN=5
# Time zone used when the profile has none
# DEFAULT_TZ=Europe/Istanbul
# On start: set commands, descriptions and the menu button of the bot
# BOT_SETUP_PROFILE=true

# ===== docker compose only =====
# Host port of the API
# API_PUBLISH=8080
# Domain for --profile https (Caddy, automatic certificates); must point to this server
# DOMAIN=fit.example.com

# ===== Alternative variable names (aliases) =====
# These longer names work too; an explicitly set short name above always wins.
#   TELEGRAM_BOT_TOKEN      = BOT_TOKEN
#   TELEGRAM_BOT_USERNAME   = BOT_USERNAME
#   TELEGRAM_WEBAPP_URL     = WEBAPP_URL   (APP_BASE_URL is used if neither is set)
# Not needed by this implementation: SESSION_SECRET (sessions are random opaque tokens stored as SHA-256 in the database),
# API_BASE_URL (the web app and the API share one origin), OWNER_TELEGRAM_ID (every user has a separate account).